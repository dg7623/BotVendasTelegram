#!/usr/bin/env python3
"""Bot de estoque para cartões digitais com gateway de pagamento."""

import json
import logging
from pathlib import Path
from typing import List, Dict, Any

from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
    CallbackQueryHandler,
    MessageHandler,
    filters,
)

from config import BOT_TOKEN, ADMIN_IDS, GATEWAY_URL, APP_NAME

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"
PRODUCTS_FILE = DATA_DIR / "products.json"
DATA_DIR.mkdir(exist_ok=True)


def load_products() -> List[Dict[str, Any]]:
    if not PRODUCTS_FILE.exists():
        PRODUCTS_FILE.write_text(json.dumps([], indent=2), encoding="utf-8")
        return []

    try:
        data = json.loads(PRODUCTS_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except json.JSONDecodeError:
        PRODUCTS_FILE.write_text(json.dumps([], indent=2), encoding="utf-8")
        return []


def save_products(products: List[Dict[str, Any]]) -> None:
    PRODUCTS_FILE.write_text(json.dumps(products, ensure_ascii=False, indent=2), encoding="utf-8")


def ensure_default_products() -> List[Dict[str, Any]]:
    products = load_products()
    if products:
        return products

    default_products = json.loads((BASE_DIR / "data" / "products.json").read_text(encoding="utf-8"))
    save_products(default_products)
    return default_products


def find_product(products: List[Dict[str, Any]], product_name: str) -> Dict[str, Any] | None:
    key = product_name.strip().lower()
    for product in products:
        if product.get("name", "").strip().lower() == key:
            return product
    return None


def format_product_line(product: Dict[str, Any]) -> str:
    return (
        f"• {product['name']} — R$ {float(product['price']):.2f} | Estoque: {product['stock']}\n"
        f"  {product.get('description', 'Sem descrição')}\n"
    )


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    user = update.effective_user
    keyboard = [
        [InlineKeyboardButton("📦 Ver catálogo", callback_data="catalog")],
        [InlineKeyboardButton("💳 Comprar via gateway", callback_data="gateway")],
        [InlineKeyboardButton("🧾 Ver estoque", callback_data="stock")],
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)

    await update.message.reply_text(
        f"Olá, {user.first_name}!\n\nBem-vindo ao {APP_NAME}.\n"
        "Aqui você pode visualizar os produtos, o estoque e finalizar a compra pelo gateway.",
        reply_markup=reply_markup,
    )


async def send_catalog(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    products = ensure_default_products()
    if not products:
        await update.message.reply_text("Nenhum produto cadastrado no estoque.")
        return

    lines = ["📦 Catálogo disponível:\n"]
    for product in products:
        lines.append(format_product_line(product))

    message = "\n".join(lines)
    keyboard = []
    for product in products:
        keyboard.append([
            InlineKeyboardButton(f"{product['name']} ({product['stock']})", callback_data=f"product_{product['id']}")
        ])
    keyboard.append([InlineKeyboardButton("🔗 Gateway de pagamento", callback_data="gateway")])
    reply_markup = InlineKeyboardMarkup(keyboard)

    if update.callback_query:
        await update.callback_query.edit_message_text(message, reply_markup=reply_markup)
    else:
        await update.message.reply_text(message, reply_markup=reply_markup)


async def send_stock(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    products = ensure_default_products()
    text = "📊 Estoque atual:\n\n"
    for product in products:
        text += f"{product['name']}: {product['stock']} unidades\n"

    keyboard = [[InlineKeyboardButton("📦 Voltar ao catálogo", callback_data="catalog")]]
    reply_markup = InlineKeyboardMarkup(keyboard)

    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=reply_markup)
    else:
        await update.message.reply_text(text, reply_markup=reply_markup)


def get_product_by_id(products: List[Dict[str, Any]], product_id: str) -> Dict[str, Any] | None:
    for product in products:
        if product.get("id") == product_id:
            return product
    return None


async def show_product_details(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    query = update.callback_query
    product_id = query.data.replace("product_", "")
    products = ensure_default_products()
    product = get_product_by_id(products, product_id)

    if not product:
        await query.answer("Produto não encontrado.", show_alert=True)
        return

    message = (
        f"🛍️ Produto: {product['name']}\n"
        f"💰 Valor: R$ {float(product['price']):.2f}\n"
        f"📦 Estoque: {product['stock']}\n\n"
        f"Descrição: {product.get('description', 'Sem descrição')}\n\n"
        "Para comprar, use o comando /pedido <nome do produto> <quantidade>\n"
        "Exemplo: /pedido AMEX 2"
    )

    keyboard = [
        [InlineKeyboardButton("💳 Ir para gateway", callback_data="gateway")],
        [InlineKeyboardButton("📦 Voltar ao catálogo", callback_data="catalog")],
    ]
    await query.edit_message_text(message, reply_markup=InlineKeyboardMarkup(keyboard))


async def send_gateway(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    gateway_text = (
        "💳 Gateway de pagamento\n\n"
        f"Clique no link abaixo para prosseguir com o pagamento:\n{GATEWAY_URL}\n\n"
        "Após o pagamento, confirme o pedido com o comando /pedido <produto> <quantidade>."
    )

    keyboard = [[InlineKeyboardButton("🔗 Abrir gateway", url=GATEWAY_URL)]]

    if update.callback_query:
        await update.callback_query.edit_message_text(gateway_text, reply_markup=InlineKeyboardMarkup(keyboard))
    else:
        await update.message.reply_text(gateway_text, reply_markup=InlineKeyboardMarkup(keyboard), disable_web_page_preview=True)


async def order_product(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not context.args or len(context.args) < 2:
        await update.message.reply_text(
            "Formato inválido. Use: /pedido <nome do produto> <quantidade>\nExemplo: /pedido AMEX 2"
        )
        return

    product_name = context.args[0].strip()
    try:
        quantity = int(context.args[1])
    except ValueError:
        await update.message.reply_text("A quantidade deve ser um número inteiro.")
        return

    if quantity <= 0:
        await update.message.reply_text("A quantidade deve ser maior que zero.")
        return

    products = ensure_default_products()
    product = find_product(products, product_name)
    if not product:
        await update.message.reply_text("Produto não encontrado. Consulte /catalog para ver os disponíveis.")
        return

    if product["stock"] < quantity:
        await update.message.reply_text(
            f"Sem estoque suficiente para {product['name']}. Estoque disponível: {product['stock']}."
        )
        return

    total = float(product["price"]) * quantity
    product["stock"] -= quantity
    save_products(products)

    text = (
        f"✅ Pedido confirmado\n\n"
        f"Produto: {product['name']}\n"
        f"Quantidade: {quantity}\n"
        f"Valor total: R$ {total:.2f}\n\n"
        f"Pagamento: {GATEWAY_URL}\n\n"
        "Seu pedido foi atualizado e o estoque foi ajustado."
    )
    await update.message.reply_text(text, disable_web_page_preview=True)


async def admin_add_product(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    user_id = update.effective_user.id
    if user_id not in ADMIN_IDS:
        await update.message.reply_text("Você não tem permissão para gerenciar o estoque.")
        return

    if len(context.args) < 3:
        await update.message.reply_text(
            "Uso: /adicionar <nome> <preco> <estoque>\nExemplo: /adicionar PREMIUM 45 20"
        )
        return

    name = context.args[0].strip()
    try:
        price = float(context.args[1])
        stock = int(context.args[2])
    except ValueError:
        await update.message.reply_text("Preço deve ser numérico e estoque deve ser inteiro.")
        return

    products = ensure_default_products()
    if find_product(products, name):
        await update.message.reply_text(f"O produto {name} já existe.")
        return

    product = {
        "id": name.lower().replace(" ", "_"),
        "name": name.upper(),
        "price": price,
        "stock": stock,
        "description": "Produto adicionado pelo admin.",
    }
    products.append(product)
    save_products(products)
    await update.message.reply_text(f"✅ Produto {name.upper()} adicionado ao estoque.")


async def admin_update_stock(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    user_id = update.effective_user.id
    if user_id not in ADMIN_IDS:
        await update.message.reply_text("Você não tem permissão para gerenciar o estoque.")
        return

    if len(context.args) < 2:
        await update.message.reply_text("Uso: /estoqueatualizar <nome do produto> <quantidade nova>")
        return

    name = context.args[0].strip()
    try:
        new_stock = int(context.args[1])
    except ValueError:
        await update.message.reply_text("A quantidade deve ser um número inteiro.")
        return

    products = ensure_default_products()
    product = find_product(products, name)
    if not product:
        await update.message.reply_text("Produto não encontrado.")
        return

    product["stock"] = new_stock
    save_products(products)
    await update.message.reply_text(f"✅ Estoque de {product['name']} atualizado para {new_stock}.")


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    text = (
        "📘 Comandos disponíveis:\n\n"
        "/start — inicia o bot\n"
        "/catalog — mostra o catálogo\n"
        "/stock — mostra o estoque\n"
        "/pedido <produto> <quantidade> — gera pedido\n"
        "/gateway — mostra o link do gateway\n"
        "/adicionar <nome> <preco> <estoque> — admin\n"
        "/estoqueatualizar <nome> <novo_estoque> — admin\n"
        "/help — mostra esta ajuda"
    )
    await update.message.reply_text(text)


async def callback_router(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    query = update.callback_query
    await query.answer()
    data = query.data

    if data == "catalog":
        await send_catalog(update, context)
    elif data == "stock":
        await send_stock(update, context)
    elif data == "gateway":
        await send_gateway(update, context)
    elif data.startswith("product_"):
        await show_product_details(update, context)


def main() -> None:
    if not BOT_TOKEN:
        raise RuntimeError("BOT_TOKEN não informado. Configure o .env antes de iniciar.")

    ensure_default_products()

    application = Application.builder().token(BOT_TOKEN).build()

    application.add_handler(CommandHandler("start", start))
    application.add_handler(CommandHandler("catalog", send_catalog))
    application.add_handler(CommandHandler("stock", send_stock))
    application.add_handler(CommandHandler("gateway", send_gateway))
    application.add_handler(CommandHandler("pedido", order_product))
    application.add_handler(CommandHandler("adicionar", admin_add_product))
    application.add_handler(CommandHandler("estoqueatualizar", admin_update_stock))
    application.add_handler(CommandHandler("help", help_command))
    application.add_handler(CallbackQueryHandler(callback_router))

    logger.info("Bot iniciado com sucesso.")
    application.run_polling()


if __name__ == "__main__":
    main()
